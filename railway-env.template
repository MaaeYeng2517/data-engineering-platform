# Railway Production Environment Variables
# Copy these to Railway Dashboard → Variables

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
DEBUG=false
APP_NAME=DataAir
APP_VERSION=1.0.0

# =============================================================================
# DATABASE (Railway PostgreSQL - auto-provided)
# =============================================================================
# DATABASE_URL will be auto-set by Railway when you add PostgreSQL plugin
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Railway Redis - auto-provided)
# =============================================================================
# REDIS_URL will be auto-set by Railway when you add Redis plugin
# REDIS_URL=redis://user:pass@host:port/db

# =============================================================================
# OBJECT STORAGE (MinIO/S3 - use Railway or external)
# =============================================================================
MINIO_ENDPOINT=your-minio-endpoint:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=true
MINIO_BUCKET=dataair

# =============================================================================
# SEARCH & VECTOR (use Railway or external services)
# =============================================================================
ELASTICSEARCH_URL=http://your-elasticsearch:9200
QDRANT_URL=http://your-qdrant:6333

# =============================================================================
# JWT AUTHENTICATION (REQUIRED FOR PRODUCTION)
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-production-jwt-secret-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# CSRF PROTECTION
# =============================================================================
# Generate with: openssl rand -hex 32
CSRF_SECRET_KEY=your-production-csrf-secret-32-chars-min

# =============================================================================
# API KEY HMAC
# =============================================================================
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=your-production-api-secret-32-chars-min

# =============================================================================
# FRONTEND & CORS
# =============================================================================
FRONTEND_URL=https://maaelab-data-air.vercel.app
PUBLIC_BASE_URL=https://maaelab-data-air.vercel.app
ALLOWED_ORIGINS=https://maaelab-data-air.vercel.app

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Set LLM_PROVIDER to pin one: openai | anthropic | google | ollama
# Leave empty to auto-select based on available keys
LLM_PROVIDER=google
LLM_OFFLINE_FALLBACK=true
LLM_REQUEST_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=AIzaSyDuqhE_jPWaznJPvjfLFstEChpJsFg3pmQ
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# CHAT SETTINGS
# =============================================================================
CHAT_SYSTEM_PROMPT=
CHAT_TEMPERATURE=0.4
CHAT_MAX_TOKENS=1024
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# ADMIN SETTINGS
# =============================================================================
ADMIN_EMAILS=your-admin@email.com

# =============================================================================
# STRIPE BILLING (Optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://maaelab-data-air.vercel.app/billing?checkout=success
STRIPE_CANCEL_URL=https://maaelab-data-air.vercel.app/billing?checkout=cancelled
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# =============================================================================
# PROFILE SECRETS ENCRYPTION
# =============================================================================
# Generate with: openssl rand -hex 32
PROFILE_SECRET_KEY=your-production-profile-secret-32-chars-min
PROFILE_SECRET_REVEAL_ENABLED=true

# =============================================================================
# EXTERNAL PLATFORMS (Optional - for connectors)
# =============================================================================
AIRFLOW_URL=http://your-airflow:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_PUBLIC_URL=http://your-airflow:8080

OPENMETADATA_URL=http://your-openmetadata:8585
OPENMETADATA_USERNAME=admin@dataair.local
OPENMETADATA_PASSWORD=admin
OPENMETADATA_PUBLIC_URL=http://your-openmetadata:8585

PROMETHEUS_URL=http://your-prometheus:9090
PROMETHEUS_PUBLIC_URL=http://your-prometheus:9090

GRAFANA_URL=http://your-grafana:3001
GRAFANA_PUBLIC_URL=http://your-grafana:3001