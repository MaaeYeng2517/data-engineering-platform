# DataAir Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
DEBUG=true
APP_NAME=DataAir
APP_VERSION=1.0.0

# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
POSTGRES_USER=dataair
POSTGRES_PASSWORD=dataair
POSTGRES_DB=dataair
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://dataair:dataair@localhost:5432/dataair
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Cache & Queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# =============================================================================
# MINIO (S3-Compatible Object Storage)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dataair

# =============================================================================
# ELASTICSEARCH (Full-Text Search)
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PORT=9200

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate secure random keys for production!
# Use: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# CSRF PROTECTION
# =============================================================================
CSRF_SECRET_KEY=dev-csrf-secret-change-in-production-min-32-chars-long

# =============================================================================
# API KEY HMAC
# =============================================================================
API_KEY_HMAC_SECRET=dev-api-secret-change-in-production-min-32-chars-long

# =============================================================================
# FRONTEND & CORS
# =============================================================================
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API with credentials.
# localhost entries are expanded to 127.0.0.1 and [::1] automatically.
ALLOWED_ORIGINS=http://localhost:3000

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# LLM PROVIDERS (Optional - add keys for AI features)
# =============================================================================
# Every provider is optional. DataAir answers with the first configured one and
# degrades to a deterministic offline assistant when none is available.
# Set LLM_PROVIDER to pin one (openai | anthropic | google | ollama); leave it
# empty to auto-select.
LLM_PROVIDER=
LLM_OFFLINE_FALLBACK=true
LLM_REQUEST_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# HOMEPAGE CHAT
# =============================================================================
CHAT_SYSTEM_PROMPT=
CHAT_TEMPERATURE=0.4
CHAT_MAX_TOKENS=1024
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# ADMIN SETTINGS
# =============================================================================
ADMIN_EMAILS=admin@example.com

# =============================================================================
# STRIPE BILLING (Optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# -----------------------------------------------------------------------------
# GRAFANA CLOUD (optional — local metrics stay local while these are empty)
# -----------------------------------------------------------------------------
# Copy these into .env to also ship Prometheus metrics to Grafana Cloud.
# Endpoint: Grafana Cloud -> Prometheus -> Remote write -> "Prometheus remote
# write endpoint". The token is a *Prometheus push* token, not the Alloy fleet
# management token.
#
#   GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-<N>-<region>.grafana.net/api/prom/push
#   GRAFANA_CLOUD_ORG_ID=<your org id>
#
# Then store the token outside git (writes docker/prometheus/secrets/, gitignored):
#   ./scripts/configure-grafana-cloud.sh <push-token>
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_ORG_ID=

# -----------------------------------------------------------------------------
# GRAFANA CLOUD — OTLP telemetry (traces)
# -----------------------------------------------------------------------------
# Traces are off until OTEL_EXPORTER_OTLP_ENDPOINT is set. The backend exports
# spans for every request, SQL query and outgoing HTTP call.
#
# Grafana Cloud -> Observability -> AgentO11y. The header is
# base64("<tenant id>:<access policy token>").
#   OTEL_SERVICE_NAME=dataair-backend
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
#   OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_NAME=dataair-backend
OTEL_SERVICE_NAMESPACE=dataair
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_WORKER_SERVICE_NAME=dataair-worker

# =============================================================================
# BACKEND & FRONTEND PORTS
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# =============================================================================
# NODE ENV
# =============================================================================
NODE_ENV=development