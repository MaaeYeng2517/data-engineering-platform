APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://data_api:change_me@localhost:5432/enterprise_data
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=enterprise-raw
S3_BUCKET_CURATED=enterprise-curated
S3_USE_SSL=false

OIDC_ISSUER=https://keycloak.local/realms/enterprise
OIDC_AUDIENCE=enterprise-data-api
OIDC_JWKS_URL=https://keycloak.local/realms/enterprise/protocol/openid-connect/certs
JWT_ALGORITHM=RS256

RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_MB=100
IDEMPOTENCY_TTL_SECONDS=3600

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PATH=/metrics

# Apache Superset (BI & Data Visualization)
SUPERSET_SECRET_KEY=change_me_superset_secret_key_min_32_chars
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@dataair.local
SUPERSET_ADMIN_FIRSTNAME=DataAir
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_PORT=8088

# Apache Ranger (Data Security & Access Control)
RANGER_PORT=6080
RANGER_ADMIN_USER=admin
RANGER_ADMIN_PASSWORD=rangeradmin
RANGER_DB_NAME=ranger
RANGER_PUBLIC_URL=http://localhost:6080
